# Copy this file to .env and fill in your own values. Never commit .env.

# Database
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coach
DATABASE_URL=postgresql+psycopg://coach:change-me@db:5432/coach

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# LLM providers (tried in this order; leave a key empty to skip that provider)
LLM_PROVIDER_ORDER=gemini,groq,openrouter,ollama
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Limits
RATE_LIMIT_PER_MINUTE=30
DAILY_TOKEN_CAP_PER_USER=50000

# Tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Frontend
VITE_API_URL=http://localhost:8000
